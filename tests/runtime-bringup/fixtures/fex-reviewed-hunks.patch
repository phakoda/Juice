diff --git a/FEXCore/Source/Interface/Core/CPUBackend.cpp b/FEXCore/Source/Interface/Core/CPUBackend.cpp
--- a/FEXCore/Source/Interface/Core/CPUBackend.cpp
+++ b/FEXCore/Source/Interface/Core/CPUBackend.cpp
@@ -325,6 +325,23 @@ namespace CPU {
   }
 
   void CPUBackend::RegisterForSignalHandler(fextl::shared_ptr<CodeBuffer> CodeBuffer) {
+#ifdef FEX_JUICE_IOS
+    /*
+     * A native branch target can be observed after its lookup generation was
+     * retired but before the translated thread reaches the replacement
+     * dispatcher.  Keep a small lock-free range history so the Windows fault
+     * bridge can distinguish that cold race from a genuine guest execute
+     * fault without retaining large code buffers indefinitely.
+     */
+    if (CodeBuffer) {
+      auto& Range = RetiredCodeBufferRanges[NextRetiredCodeBufferRange.fetch_add(1, std::memory_order_relaxed) %
+                                            RetiredCodeBufferRangeCount];
+      const uintptr_t Begin = reinterpret_cast<uintptr_t>(CodeBuffer->Ptr);
+      Range.Begin.store(0, std::memory_order_release);
+      Range.End.store(Begin + CodeBuffer->AllocatedSize, std::memory_order_relaxed);
+      Range.Begin.store(Begin, std::memory_order_release);
+    }
+#endif
     if (ThreadState->CurrentFrame->SignalHandlerRefCounter != 0) {
       // We have signal handlers that have generated code
       // This means that we can not safely clear the code at this point in time
@@ -452,5 +469,18 @@ namespace CPU {
     return false;
   }
 
+  bool CPUBackend::IsAddressInRetiredCodeBuffer(uintptr_t Address) const {
+#ifdef FEX_JUICE_IOS
+    for (const auto& Range : RetiredCodeBufferRanges) {
+      const uintptr_t Begin = Range.Begin.load(std::memory_order_acquire);
+      const uintptr_t End = Range.End.load(std::memory_order_relaxed);
+      if (Begin && Address >= Begin && Address < End) {
+        return true;
+      }
+    }
+#endif
+    return false;
+  }
+
 } // namespace CPU
 } // namespace FEXCore
