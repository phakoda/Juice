@@ -15,6 +15,8 @@
 #include <FEXCore/fextl/vector.h>
 #include <FEXCore/fextl/map.h>
 
+#include <array>
+#include <atomic>
 #include <cstdint>
 
 namespace FEXCore::CPU {
@@ -202,6 +204,14 @@ namespace CPU {
     CodeBufferManager& CodeBuffers;
 
   private:
+    struct RetiredCodeBufferRange {
+      std::atomic<uintptr_t> Begin {};
+      std::atomic<uintptr_t> End {};
+    };
+    static constexpr size_t RetiredCodeBufferRangeCount = 8;
+    std::array<RetiredCodeBufferRange, RetiredCodeBufferRangeCount> RetiredCodeBufferRanges {};
+    std::atomic<size_t> NextRetiredCodeBufferRange {};
+
     void RegisterForSignalHandler(fextl::shared_ptr<CodeBuffer>);
   };
 
diff --git a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
--- a/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
+++ b/FEXCore/Source/Interface/Core/Dispatcher/Dispatcher.cpp
@@ -36,11 +36,25 @@
 
 constexpr size_t MAX_DISPATCHER_CODE_SIZE = FEXCore::Utils::FEX_PAGE_SIZE * 4;
 
+static void* AllocateDispatcherCode() {
+#ifdef FEX_JUICE_IOS
+  /* iOS accepts the RW -> RX transition but leaves a mapping created RWX
+   * hardware-NX, even though mmap itself succeeds. */
+  return FEXCore::Allocator::VirtualAllocECCode(MAX_DISPATCHER_CODE_SIZE, false);
+#else
+  return FEXCore::Allocator::VirtualAlloc(MAX_DISPATCHER_CODE_SIZE, true);
+#endif
+}
+
 Dispatcher::Dispatcher(FEXCore::Context::ContextImpl* ctx)
-  : Arm64Emitter(ctx, FEXCore::Allocator::VirtualAlloc(MAX_DISPATCHER_CODE_SIZE, true), MAX_DISPATCHER_CODE_SIZE)
+  : Arm64Emitter(ctx, AllocateDispatcherCode(), MAX_DISPATCHER_CODE_SIZE)
   , CTX {ctx} {
   EmitDispatcher();
 
+#ifdef FEX_JUICE_IOS
+  FEXCore::Allocator::VirtualProtect(reinterpret_cast<void*>(GetBufferBase()), MAX_DISPATCHER_CODE_SIZE,
+                                     FEXCore::Allocator::ProtectOptions::Read | FEXCore::Allocator::ProtectOptions::Exec);
+#endif
   FEXCore::Allocator::VirtualName("FEXMem_Misc", reinterpret_cast<void*>(GetBufferBase()), MAX_DISPATCHER_CODE_SIZE);
 }
 
