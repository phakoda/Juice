diff --git a/FEXCore/Source/Interface/Core/JuiceCodegenPolicy.h b/FEXCore/Source/Interface/Core/JuiceCodegenPolicy.h
new file mode 100644
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/JuiceCodegenPolicy.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace FEXCore::Juice {
+struct CodeSpan { uint64_t Offset {}, End {}; };
+
+// Pure arithmetic only: does not allocate memory or grant execute permission.
+// Round both ends so publishing a block cannot reopen an older RX page or
+// include the trailing guard page. The caller must replan after cache rollover.
+inline bool PlanCodeSpan(uint64_t cursor, uint64_t bytes, uint64_t capacity,
+                         uint64_t alignment, CodeSpan& out) {
+  out = {};
+  constexpr uint64_t Max = std::numeric_limits<uint64_t>::max();
+  if (!bytes || !alignment || (alignment & (alignment - 1)) || cursor > capacity ||
+      cursor > Max - (alignment - 1)) return false;
+  const uint64_t begin = (cursor + alignment - 1) & ~(alignment - 1);
+  if (begin > capacity || bytes > capacity - begin) return false;
+  const uint64_t end = begin + bytes;
+  if (end > Max - (alignment - 1)) return false;
+  const uint64_t rounded = (end + alignment - 1) & ~(alignment - 1);
+  if (rounded > capacity) return false;
+  out = {begin, rounded};
+  return true;
+}
+
+// Used from the Windows fault bridge. Never spin on an interrupted writer,
+// allocate, or take a lock. A contended/in-progress record is simply not evidence.
+// Sequential consistency orders endpoints and sequence as one bounded snapshot;
+// separate acquire/release endpoints can combine different retired generations.
+class RetiredCodeRange {
+  static_assert(std::atomic<uintptr_t>::is_always_lock_free);
+  static_assert(std::atomic<uint64_t>::is_always_lock_free);
+  std::atomic<uint64_t> Sequence {};
+  std::atomic<uintptr_t> Begin {}, End {};
+public:
+  bool Publish(uintptr_t begin, size_t bytes) {
+    if (!begin || !bytes || bytes > std::numeric_limits<uintptr_t>::max() - begin) return false;
+    uint64_t sequence = Sequence.load();
+    // Do not wrap a sequence into a value a paused reader could have observed.
+    if ((sequence & 1) || sequence >= std::numeric_limits<uint64_t>::max() - 1) return false;
+    if (!Sequence.compare_exchange_strong(sequence, sequence + 1)) return false;
+    Begin.store(begin);
+    End.store(begin + bytes);
+    Sequence.store(sequence + 2);
+    return true;
+  }
+  bool Contains(uintptr_t address) const {
+    const uint64_t before = Sequence.load();
+    if (!before || (before & 1)) return false;
+    const uintptr_t begin = Begin.load(), end = End.load();
+    return before == Sequence.load() && begin && address >= begin && address < end;
+  }
+};
+} // namespace FEXCore::Juice
