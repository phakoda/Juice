+#ifdef JUICE_EMBEDDED
+/* Private socketpair transport: no listening filesystem socket, no daemon and
+ * no reconnect to an unrelated process. Registry cwd is per-thread on Darwin. */
+void juice_server_open_embedded(void)
+{
+    server_dir = create_server_dir(1);
+    init_tracing_mechanism();
+}
+int juice_server_adopt_embedded(int fd)
+{
+    struct process *process;
+    struct thread *thread;
+    if (fd < 0 || fcntl(fd, F_SETFL, O_NONBLOCK) == -1) return 0;
+    if (!(process = create_process(fd, NULL, 0, NULL, NULL, NULL, 0, NULL))) return 0;
+    thread = create_thread(-1, process, NULL);
+    if (thread) add_process_thread(process, thread);
+    release_object(process);
+    return thread != NULL;
+}
+#endif
