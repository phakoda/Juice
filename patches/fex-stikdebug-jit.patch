 #include <cstddef>
 #include <cstdint>
 #include <sys/types.h>
@@ -120,6 +121,57 @@ inline bool VirtualProtect(void* Ptr, size_t Size, ProtectOptions options) {
   DWORD old_prot {};
   return ::VirtualProtect(Ptr, Size, prot, &old_prot) != 0;
 }
+
+struct JuiceJITMapping {
+  void* Writable {};
+  void* Executable {};
+  bool DualMapped {};
+};
+
+#ifdef FEX_JUICE_IOS
+extern "C" long __stdcall NtWineAllocateJitMemory(void** WriteAddress, void** ExecAddress, size_t Size);
+extern "C" long __stdcall NtWineFreeJitMemory(void* WriteAddress, void* ExecAddress, size_t Size);
+extern "C" long __stdcall NtWineDetachJitDebugger(void);
+
+inline bool JuiceStikDebugJITEnabled() {
+  static const bool Enabled = []() {
+    const char* Value = std::getenv("JUICE_STIKDEBUG_JIT");
+    return Value && Value[0] == '1' && Value[1] == '\0';
+  }();
+  return Enabled;
+}
+
+inline JuiceJITMapping JuiceAllocateJITMapping(size_t Size) {
+  if (JuiceStikDebugJITEnabled()) {
+    void* Writable {};
+    void* Executable {};
+    const long Status = NtWineAllocateJitMemory(&Writable, &Executable, Size);
+    if (!Status && Writable && Executable) {
+      return {Writable, Executable, true};
+    }
+    return {};
+  }
+
+  void* Mapping = VirtualAllocECCode(Size, false);
+  return {Mapping, Mapping, false};
+}
+
+inline bool JuiceFreeJITMapping(JuiceJITMapping Mapping, size_t Size) {
+  if (!Mapping.Executable) return true;
+  if (Mapping.DualMapped) {
+    return NtWineFreeJitMemory(Mapping.Writable, Mapping.Executable, Size) == 0;
+  }
+  VirtualFree(Mapping.Executable, Size);
+  return true;
+}
+
+inline bool JuicePublishJITMapping(JuiceJITMapping Mapping, size_t Size) {
+  if (Mapping.DualMapped) return true;
+  return VirtualProtect(Mapping.Executable, Size, ProtectOptions::Read | ProtectOptions::Exec);
+}
+#else
+inline bool JuiceStikDebugJITEnabled() { return false; }
+#endif
 
 FEX_DEFAULT_VISIBILITY extern VirtualNamePtr VirtualName;
 FEX_DEFAULT_VISIBILITY extern VirtualTHPPtr VirtualTHPControl;
