+inline bool JuiceDetachJITDebugger() {
+  if (!JuiceStikDebugJITEnabled()) return true;
+
+  auto& Pool = JuiceGetJITPool();
+  std::lock_guard<std::mutex> Lock(Pool.Mutex);
+  if (!Pool.Executable || !Pool.Writable) return false;
+  if (Pool.Detached) return true;
+
+  const long Status = NtWineDetachJitDebugger();
+  if (Status) {
+    LogMan::Msg::EFmt("Failed to detach StikDebug JIT debugger (status=0x{:x})", Status);
+    return false;
+  }
+  Pool.Detached = true;
+  LogMan::Msg::IFmt("StikDebug JIT pool sealed; debugger detached");
+  return true;
+}
