+inline size_t JuiceAlignJITSize(size_t Size) {
+  constexpr size_t Alignment = 16 * 1024;
+  constexpr size_t AlignmentMask = Alignment - 1;
+  if (Size > static_cast<size_t>(-1) - AlignmentMask) {
+    return 0;
+  }
+  return (Size + AlignmentMask) & ~AlignmentMask;
+}
