+inline size_t JuiceJITPoolReserveSize() {
+  static const size_t ReserveSize = []() {
+    constexpr size_t MiB = 1024 * 1024;
+    constexpr size_t DefaultReserve = 384 * MiB;
+    const char* Value = std::getenv("JUICE_STIKDEBUG_JIT_POOL_MB");
+    if (!Value || !Value[0]) {
+      return DefaultReserve;
+    }
+
+    char* End {};
+    const unsigned long long Megabytes = std::strtoull(Value, &End, 10);
+    if (!End || End == Value || End[0] != '\0' || Megabytes < 256 || Megabytes > 1024) {
+      LogMan::Msg::EFmt("Ignoring invalid JUICE_STIKDEBUG_JIT_POOL_MB='{}'; using {} MiB", Value, DefaultReserve / MiB);
+      return DefaultReserve;
+    }
+    return static_cast<size_t>(Megabytes) * MiB;
+  }();
+  return ReserveSize;
+}
