+/***********************************************************************
+ *             NtWineFreeJitMemory   (NTDLL.@)
+ */
+NTSTATUS WINAPI NtWineFreeJitMemory( void *write_address, void *exec_address, SIZE_T size )
+{
+#if defined(__APPLE__) && defined(__aarch64__)
+    struct juice_jit_record **cursor, *record;
+    sigset_t sigset;
+    BOOL valid;
+
+    if (!write_address || !exec_address || !size || size > ~(SIZE_T)0 - host_page_mask)
+        return STATUS_INVALID_PARAMETER;
+    size = ROUND_SIZE( 0, size, host_page_mask );
+    pthread_mutex_lock( &juice_jit_mutex );
+    for (cursor = &juice_jit_records; (record = *cursor); cursor = &record->next)
+        if (record->write_address == write_address && record->exec_address == exec_address && record->size == size) break;
+    if (!record) { pthread_mutex_unlock( &juice_jit_mutex ); return STATUS_INVALID_ADDRESS; }
+    server_enter_uninterrupted_section( &virtual_mutex, &sigset );
+    valid = juice_unregister_jit_pair_locked( record );
+    server_leave_uninterrupted_section( &virtual_mutex, &sigset );
+    if (!valid) { pthread_mutex_unlock( &juice_jit_mutex ); return STATUS_INVALID_ADDRESS; }
+    *cursor = record->next;
+    vm_deallocate( mach_task_self(), (vm_address_t)write_address, size );
+    vm_deallocate( mach_task_self(), (vm_address_t)exec_address, size );
+    free( record );
+    pthread_mutex_unlock( &juice_jit_mutex );
     return STATUS_SUCCESS;
 #else
     return STATUS_NOT_SUPPORTED;
@@ -5987,41 +6063,36 @@
 }
 
