new file mode 100644
index 000000000..38791f11b
--- /dev/null
+++ b/FEXCore/Source/Interface/Core/JuiceIOSArm64EC.h
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cstdint>
+
+#ifdef FEX_JUICE_IOS
+extern "C" long __stdcall NtWineGetCurrentTebAccessor(void** Accessor);
+
+/*
+ * FEXCore deliberately has no dependency on FEX's private Windows structure
+ * definitions.  Use the stable ARM64EC TEB/PEB offsets directly here: these
+ * are the same offsets emitted by Dispatcher.cpp and Module.S.
+ */
+static inline bool JuiceIsEcCode(uint64_t Address) {
+  constexpr uint64_t WindowsPageShift = 12;
+  constexpr uintptr_t TebPebOffset = 0x60;
+  constexpr uintptr_t PebEcCodeBitmapOffset = 0x368;
+  using TebAccessor = void* (*)();
+  static TebAccessor Accessor {};
+
+  if (!Accessor) {
+    void* AccessorAddress {};
+    if (NtWineGetCurrentTebAccessor(&AccessorAddress) || !AccessorAddress) {
+      return false;
+    }
+    Accessor = reinterpret_cast<TebAccessor>(AccessorAddress);
+  }
+
+  auto* Teb = static_cast<uint8_t*>(Accessor());
+  if (!Teb) {
+    return false;
+  }
+#if defined(__aarch64__)
+  asm volatile("mov x18, %0" : : "r"(Teb) : "x18");
+#endif
+  auto* Peb = *reinterpret_cast<uint8_t**>(Teb + TebPebOffset);
+  if (!Peb) {
+    return false;
+  }
+  const auto* Map = *reinterpret_cast<const uint64_t**>(Peb + PebEcCodeBitmapOffset);
+  if (!Map) {
+    return false;
+  }
+
+  const uint64_t Page = Address >> WindowsPageShift;
+  return (Map[Page / 64] >> (Page & 63)) & 1;
+}
+#endif
